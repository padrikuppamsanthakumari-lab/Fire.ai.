HTML

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>FIRE AI</title>

<style>
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: Arial, sans-serif;
  min-height: 100vh;
  color: white;
  background: radial-gradient(
    circle at bottom,
    #154b91,
    #06152e 60%,
    #010611
  );
}

.stars {
  position: fixed;
  inset: 0;
  z-index: -1;
  pointer-events: none;
  background-image:
    radial-gradient(2px 2px at 30px 40px, white, transparent),
    radial-gradient(2px 2px at 150px 100px, #55caff, transparent),
    radial-gradient(2px 2px at 250px 200px, white, transparent),
    radial-gradient(2px 2px at 350px 60px, #80dfff, transparent);
  background-size: 400px 300px;
  animation: move 25s linear infinite;
}

@keyframes move {
  to { background-position: 400px 300px; }
}

header {
  text-align: center;
  padding: 35px 10px 20px;
}

h1 {
  font-size: 45px;
  color: #52bdff;
  text-shadow: 0 0 15px #008cff,
               0 0 30px #008cff;
}

header p {
  margin-top: 12px;
  color: #b9dfff;
}

.container {
  width: 92%;
  max-width: 650px;
  margin: 25px auto;
  padding: 20px;
  background: rgba(3,18,45,.92);
  border: 1px solid #168cff;
  border-radius: 20px;
  box-shadow: 0 0 30px #087bff55;
}

.status {
  text-align: center;
  color: #4effd2;
  margin-bottom: 15px;
}

#chatbox {
  height: 350px;
  overflow-y: auto;
  padding: 12px;
  background: #020b1c;
  border-radius: 12px;
  margin-bottom: 15px;
}

.message {
  padding: 12px;
  margin: 10px 0;
  border-radius: 12px;
  line-height: 1.5;
  overflow-wrap: anywhere;
  white-space: pre-wrap;
}

.bot {
  background: #102e56;
  border: 1px solid #176fc5;
}

.user {
  background: #0759ad;
  text-align: right;
  margin-left: 15%;
}

.input-area {
  display: flex;
  gap: 8px;
}

input {
  flex: 1;
  min-width: 0;
  padding: 14px;
  border-radius: 10px;
  border: 1px solid #168cff;
  background: #06152e;
  color: white;
}

button {
  padding: 12px 17px;
  border: none;
  border-radius: 10px;
  background: #087bff;
  color: white;
  font-weight: bold;
  cursor: pointer;
}

button:hover {
  background: #00aaff;
}

footer {
  text-align: center;
  padding: 25px;
  color: #9acbff;
}

@media(max-width:400px) {
  h1 { font-size: 36px; }
  .container { padding: 12px; }
  button { padding: 12px; }
}
</style>
</head>

<body>

<div class="stars"></div>

<header>
  <h1>🔥 FIRE AI</h1>
  <p>YOUR PERSONAL AI ASSISTANT</p>
</header>

<main class="container">

  <div class="status">● FIRE AI IS ONLINE</div>

  <div id="chatbox">
    <div class="message bot">
      Hello! 👋 Welcome to FIRE AI.
      Ask me anything!
    </div>
  </div>

  <div class="input-area">
    <input
      id="question"
      placeholder="Message FIRE AI..."
      autocomplete="off"
    >
    <button onclick="sendMessage()">SEND</button>
  </div>

</main>

<footer>
  © 2026 FIRE AI | Explore the Future 🚀
</footer>

<script>
const input = document.getElementById("question");
const chatbox = document.getElementById("chatbox");

function addMessage(text, type) {
  const div = document.createElement("div");
  div.className = "message " + type;
  div.textContent = text;
  chatbox.appendChild(div);
  chatbox.scrollTop = chatbox.scrollHeight;
}

function getReply(question) {
  const q = question.toLowerCase();

  if (q.includes("hello") || q.includes("hi"))
    return "Hello! Welcome to FIRE AI!";

  if (q.includes("your name"))
    return "My name is FIRE AI!";

  if (q.includes("who created you"))
    return "I am the FIRE AI project!";

  if (q.includes("space"))
    return "Space contains stars, planets and galaxies!";

  if (q.includes("india"))
    return "India is a beautiful country in Asia!";

  if (q.includes("help"))
    return "I am ready to help you. Ask me a question!";

  return "Interesting question! I am currently a demo chatbot. Connect a real AI model for intelligent answers.";
}

function sendMessage() {
  const text = input.value.trim();

  if (!text) return;

  addMessage(text, "user");
  input.value = "";

  addMessage(getReply(text), "bot");
}

input.addEventListener("keydown", function(event) {
  if (event.key === "Enter") {
    sendMessage();
  }
});
</script>

</body>
</html>
